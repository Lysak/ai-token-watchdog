<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-token-watchdog.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__WATCHDOG_PATH__</string>
    </array>

    <!-- Fixed local hours — set by install.sh from MONITOR_HOURS in .env -->
    <key>StartCalendarInterval</key>
    <array>
__MONITOR_HOURS_XML__
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/monitor.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/monitor.error.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
