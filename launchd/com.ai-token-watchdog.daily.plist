<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-token-watchdog.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__WATCHDOG_PATH__</string>
        <string>--daily</string>
    </array>

    <!-- Hour set by install.sh from DAILY_REPORT_HOUR in .env (default: 18) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__DAILY_REPORT_HOUR__</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/daily.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/daily.error.log</string>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
