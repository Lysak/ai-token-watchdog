<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Disabled legacy subsystem: watchdog must only read through CodexBar CLI. -->
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__STATE_DIR__/refresh-partition.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/Library/Keychains/login.keychain-db</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>Disabled</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__STATE_DIR__/agent.log</string>
    <key>StandardErrorPath</key>
    <string>__STATE_DIR__/agent.log</string>
</dict>
</plist>
