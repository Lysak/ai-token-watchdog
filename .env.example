# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Schedule — launchd/install.sh reads these values
MONITOR_HOURS=10,14,16,20
DAILY_REPORT_HOUR=18

# Timezone and working hours (pacing calculations use these)
TIMEZONE=Europe/Kyiv
WORK_START_HOUR=8
WORK_END_HOUR=22

# How many days before expiry to start showing Codex reset credit warnings (default: 14)
# RESET_CREDIT_WARN_DAYS=14

# Cooldown (hours) between repeated error alerts, e.g. when codexbar hangs/times out
# on the 10-minute --reset-check schedule — avoids spamming an alert every run (default: 1)
# ERROR_COOLDOWN_HOURS=1

# Tool paths (defaults work if installed via Homebrew)
# CODEXBAR_PATH=/opt/homebrew/bin/codexbar

# Providers — enable/disable (true/false)
# Pattern: PROVIDER_{NAME}_ENABLED — add a new line to add a provider, no code changes needed
PROVIDER_CODEX_ENABLED=true
PROVIDER_CLAUDE_ENABLED=true
PROVIDER_PERPLEXITY_ENABLED=true
